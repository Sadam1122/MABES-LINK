# PostgreSQL lokal dari docker-compose.yml
DATABASE_URL="postgresql://mabeslink:mabeslink_local@localhost:5434/mabeslink?schema=public"

# Buat nilai acak minimal 32 karakter, misalnya: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Browser menghubungi provider tile; jangan kirim data pribadi/rahasia.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
NEXT_PUBLIC_MAP_MAX_ZOOM="19"

# Worker jadwal terpisah (default 60 detik) dan SSE near-realtime (default 2 detik).
WORKER_POLL_INTERVAL_MS="60000"
SSE_POLL_INTERVAL_MS="2000"

# Aman secara default: tidak ada email keluar. Isi kredensial hanya di server.
EMAIL_ENABLED="false"
SMTP_DRY_RUN="true"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MABES LINK <no-reply@example.invalid>"
EMAIL_DAILY_LIMIT="250"

# Penyimpanan privat di luar webroot. Direktori ini harus memakai volume persisten.
PRIVATE_STORAGE_PATH=".data/private-uploads"
LOCATION_PHOTO_MAX_FILES="3"
LOCATION_PHOTO_MAX_BYTES="5242880"
LOCATION_PHOTO_MAX_DIMENSION="8000"

# Entri referensi manual nonaktif agar tidak membentuk basis prospek kedua.
ALLOW_MANUAL_REFERENCE_ENTRY="false"

# Penerima tunggal yang diizinkan oleh smoke test SMTP eksplisit.
TEST_NOTIFICATION_EMAIL="sadamalrasyid1@gmail.com"

# Provisioning satu kali; kosongkan/hapus setelah ADMIN awal dibuat.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
