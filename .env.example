# APP
APP_URL="http://localhost:3000"
PUBLIC_RATE_LIMIT_TRUST_PROXY="false"
ALLOW_MANUAL_REFERENCE_ENTRY="false"
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
NEXT_PUBLIC_MAP_MAX_ZOOM="19"
# Opsional: endpoint Photon-compatible yang di-host/diizinkan organisasi; bukan demo publik.
# Kosong = pencarian internal mati; pin manual dan tautan Google Maps tetap tersedia.
LOCATION_SEARCH_URL=""
# Opsional: iframe Google Maps di beranda. Maps Embed API memerlukan key dan billing;
# batasi key dengan HTTP referrer/domain internal. Tanpa konfigurasi tampil peta Leaflet cabang.
GOOGLE_MAPS_EMBED_KEY=""
# Alternatif tanpa key: Google Maps > Bagikan > Sematkan peta > salin src iframe.
# Hanya URL https://www.google.com/maps/embed?pb=... yang diterima. Jangan isi data nasabah.
GOOGLE_MAPS_EMBED_URL=""
# Daftar kode produk yang telah disetujui pemilik proses untuk penawaran di Mapping.
# Kosong = discovery tetap bisa dicatat, tetapi penawaran produk terkunci.
# Pilihan teknis: LIVIN_MERCHANT_QRIS,LIVIN_MERCHANT_EDC,KOPRA_CASH_MANAGEMENT,LIVIN_ACCOUNT_OPENING
MAPPING_APPROVED_PRODUCT_CODES=""

# AUTH — buat secret acak minimal 32 karakter; hanya server
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# DATABASE — PostgreSQL lokal dari docker-compose.yml
DATABASE_URL="postgresql://mabeslink:mabeslink_local@localhost:5434/mabeslink?schema=public"

# SMTP — aman secara default; SMTP_PASS adalah SMTP key, bukan API key
EMAIL_ENABLED="false"
SMTP_DRY_RUN="true"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_DAILY_LIMIT="250"

# WORKER — proses terpisah, interval jadwal default 60 detik
WORKER_POLL_INTERVAL_MS="60000"

# NOTIFICATIONS — SSE memeriksa DB tiap 2 detik; email uji dibatasi ke alamat ini
SSE_POLL_INTERVAL_MS="2000"
TEST_NOTIFICATION_EMAIL="sadamalrasyid1@gmail.com"

# STORAGE — wajib volume persisten di luar webroot
PRIVATE_STORAGE_PATH=".data/private-uploads"
LOCATION_PHOTO_MAX_FILES="3"
LOCATION_PHOTO_MAX_BYTES="5242880"
LOCATION_PHOTO_MAX_DIMENSION="8000"

# TESTING — jangan aktifkan pada database operasional/production
DATABASE_PURPOSE="operational"
TEST_DATABASE_NAME="mabeslink_test"
ROLE_SEED_ENABLED="false"
ROLE_SEED_CONFIRM=""
