generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OUT_BRANCH
  CS
  SUPERVISOR
  ADMIN
}

enum OpportunityStage {
  NEW
  NEED_CONFIRMED
  FOLLOW_UP
  HANDOVER
  PROCESSING
  READY
  CLOSED_LOST
}

enum FollowUpStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum BatchType {
  SINGLE
  PAYROLL
}

enum HandoverStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PROCESSING
  ON_HOLD
  ESCALATED
  READY
}

enum ExceptionCategory {
  OLD_PHONE_OTP
  FACE_RECOGNITION
  BLOCK_OR_ACTIVATION
  OTHER_REAL_BLOCKER
}

enum ExceptionStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
}

enum UsageStatus {
  VERIFIED
  REJECTED
}

enum FoodScreenRule {
  EITHER
  BOTH
}

enum MappingOfferResponse {
  NOT_ASKED
  INTERESTED
  FOLLOW_UP
  NOT_INTERESTED
  NOT_RELEVANT
}

enum MappingMarkerIcon {
  STORE
  FOOD
  MARKET
  OFFICE
  HEALTH
  SERVICE
  TOWER
  CAFE
  BAKERY
  HOTEL
  SCHOOL
  WAREHOUSE
  FACTORY
  BANK
  PHARMACY
  SALON
  GYM
  AUTO
  ELECTRONICS
  FASHION
  FLORIST
  HOUSE
  MALL
  LOGISTICS
  WORSHIP
  PARK
}

enum VisitOutcome {
  CONTACTED
  NEED_CONFIRMED
  FOLLOW_UP_REQUIRED
  HANDOVER_READY
  NO_ACTION
}

enum NotificationType {
  PIC_ASSIGNMENT
  HANDOVER_ASSIGNMENT
  FOLLOW_UP_PRE_DUE
  FOLLOW_UP_DUE
  OVERDUE_DIGEST
  SERVICE_ASSIGNMENT
  SERVICE_STATUS
  APPOINTMENT_ACTION_DUE
  APPOINTMENT_PRE_DUE
}

enum OutboxJobType {
  FOLLOW_UP_PRE_DUE
  FOLLOW_UP_DUE
  OVERDUE_DIGEST
  APPOINTMENT_ACTION_DUE
  APPOINTMENT_PRE_DUE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  UNKNOWN
}

enum EmailDeliveryStatus {
  QUEUED
  DRY_RUN
  SMTP_ACCEPTED
  FAILED
  UNKNOWN
  DISABLED
  QUOTA_BLOCKED
}

enum ServiceCaseStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_SYSTEM
  ESCALATED
  HANDLED
  VERIFIED
  CLOSED
  REOPENED
  CANCELLED
}

enum AppointmentStatus {
  NEEDS_SCHEDULING
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AcquisitionStatus {
  PROSPECT
  FOLLOW_UP
  PROCESS
  SUCCESS
  UNSUCCESSFUL
}

enum AcquisitionMetricUnit {
  CUSTOMER
  ACCOUNT
  MERCHANT
  IDR
}

enum CaseOrigin {
  IN_BRANCH
  OUT_BRANCH
}

model Branch {
  id              String          @id @default(cuid())
  code            String          @unique @db.VarChar(10)
  name            String          @db.VarChar(120)
  classCode       String          @db.VarChar(10)
  timezone        String          @default("Asia/Jakarta") @db.VarChar(50)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  users           User[]
  prospects       Prospect[]
  handoverBatches HandoverBatch[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  outboxJobs      OutboxJob[]
  serviceCases    ServiceCase[]
  homeBanners     HomeBanner[]

  @@index([code])
}

// Tabel inti Better Auth, diperluas dengan role dan cabang aplikasi.
model User {
  id                        String                   @id @default(cuid())
  name                      String
  email                     String                   @unique
  emailVerified             Boolean                  @default(false)
  image                     String?
  role                      Role                     @default(OUT_BRANCH)
  active                    Boolean                  @default(true)
  emailNotificationsEnabled Boolean                  @default(true)
  isTest                    Boolean                  @default(false)
  branchId                  String?
  branch                    Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(3)
  sessions                  Session[]
  accounts                  Account[]
  createdProspects          Prospect[]               @relation("ProspectCreator")
  assignedProspects         Prospect[]               @relation("ProspectAssignee")
  followUps                 FollowUp[]               @relation("FollowUpAssignee")
  sentBatches               HandoverBatch[]          @relation("HandoverSender")
  receivedBatches           HandoverBatch[]          @relation("HandoverReceiver")
  exceptionCases            ExceptionCase[]          @relation("ExceptionAssignee")
  usageVerifications        UsageVerification[]      @relation("UsageRecorder")
  auditLogs                 AuditLog[]               @relation("AuditActor")
  visits                    Visit[]                  @relation("VisitCreator")
  notifications             Notification[]           @relation("NotificationRecipient")
  outboxJobs                OutboxJob[]              @relation("OutboxRecipient")
  emailDeliveries           EmailDelivery[]          @relation("EmailRecipient")
  createdServiceCases       ServiceCase[]            @relation("ServiceCaseCreator")
  assignedServiceCases      ServiceCase[]            @relation("ServiceCasePic")
  serviceCaseParticipants   ServiceCaseParticipant[]
  acceptedServiceCases      ServiceCase[]            @relation("ServiceCaseAcceptor")
  locationPhotos            LocationPhoto[]          @relation("LocationPhotoCreator")
  mappingOpportunities      MappingOpportunity[]     @relation("MappingOpportunityAssignee")
  homeBanners               HomeBanner[]             @relation("HomeBannerCreator")

  @@index([branchId, role, active])
}

model HomeBanner {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(240)
  storageKey  String   @unique @db.VarChar(180)
  mimeType    String   @db.VarChar(40)
  byteSize    Int
  width       Int
  height      Int
  checksum    String   @db.VarChar(64)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User     @relation("HomeBannerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([branchId, active, sortOrder, createdAt])
  @@index([createdById, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model Prospect {
  id                     String              @id @default(cuid())
  internalCode           String              @unique @db.VarChar(30)
  cakraReference         String?             @unique @db.VarChar(80)
  businessAlias          String              @db.VarChar(120)
  need                   String              @db.VarChar(500)
  contactPic             String              @db.VarChar(100)
  areaBlock              String?             @db.VarChar(100)
  businessSector         String?             @db.VarChar(100)
  addressHint            String?             @db.VarChar(220)
  latitude               Decimal?            @db.Decimal(10, 7)
  longitude              Decimal?            @db.Decimal(10, 7)
  productNeeds           String[]            @default([])
  locationLabel          String?             @db.VarChar(120)
  locationSource         String?             @db.VarChar(32)
  mappingImportedAt      DateTime?           @db.Timestamptz(3)
  locationUpdatedAt      DateTime?           @db.Timestamptz(3)
  mappingMarkerIcon      MappingMarkerIcon   @default(STORE)
  publicQrisRequestId    String?             @unique @db.VarChar(80)
  publicDedupKey         String?             @unique @db.VarChar(64)
  publicContactPhone     String?             @db.VarChar(30)
  publicBusinessCategory String?             @db.VarChar(100)
  publicBankRelationship String?             @db.VarChar(30)
  publicContactWindow    String?             @db.VarChar(100)
  publicContactConsentAt DateTime?           @db.Timestamptz(3)
  publicQrisTemplate     String?             @db.VarChar(40)
  publicQrisDesignedAt   DateTime?           @db.Timestamptz(3)
  isTest                 Boolean             @default(false)
  testNamespace          String?             @db.VarChar(80)
  opportunityStage       OpportunityStage    @default(NEW)
  branchId               String
  branch                 Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedToId           String
  assignedTo             User                @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById            String?
  createdBy              User?               @relation("ProspectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version                Int                 @default(1)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  followUps              FollowUp[]
  handoverItems          HandoverItem[]
  exceptionCases         ExceptionCase[]
  usageVerifications     UsageVerification[]
  visits                 Visit[]
  serviceCases           ServiceCase[]
  locationPhotos         LocationPhoto[]
  mappingDiscovery       MappingDiscovery?
  mappingOpportunities   MappingOpportunity[]

  @@index([branchId, isTest, opportunityStage, updatedAt])
  @@index([assignedToId, opportunityStage])
  @@index([businessAlias])
  @@index([branchId, areaBlock, businessSector])
  @@index([latitude, longitude])
  @@index([branchId, publicContactConsentAt])
  @@index([branchId, mappingImportedAt])
}

model QrisDesignSession {
  id         String   @id @default(cuid())
  tokenHash  String   @db.VarChar(64)
  storageKey String   @unique @db.VarChar(180)
  mimeType   String   @db.VarChar(60)
  width      Int
  height     Int
  qrDigest   String   @db.VarChar(64)
  publicRequestId String? @db.VarChar(80)
  selectedTemplate String? @db.VarChar(40)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model PublicRateLimit {
  key       String   @id @db.VarChar(80)
  count     Int      @default(0)
  windowEnd DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([windowEnd])
}

model FollowUp {
  id            String         @id @default(cuid())
  prospectId    String
  prospect      Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assignedToId  String
  assignedTo    User           @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  summary       String         @db.VarChar(500)
  nextAction    String         @db.VarChar(300)
  dueAt         DateTime       @db.Timestamptz(3)
  status        FollowUpStatus @default(PLANNED)
  completedAt   DateTime?      @db.Timestamptz(3)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  notifications Notification[]
  outboxJobs    OutboxJob[]
  mappingOpportunity MappingOpportunity?

  @@index([assignedToId, status, dueAt])
  @@index([prospectId, createdAt])
}

model MappingDiscovery {
  id                 String         @id @default(cuid())
  prospectId         String         @unique
  prospect           Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  segments           String[]       @default([])
  opportunityTags    String[]       @default([])
  usedProductsKnown  Boolean        @default(false)
  usedProducts       String[]       @default([])
  usedProductsOther  String?        @db.VarChar(120)
  sourceType         String?        @db.VarChar(40)
  sourceNeedHint     String?        @db.VarChar(500)
  sourceUrl          String?        @db.VarChar(300)
  sourceCheckedAt    DateTime?      @db.Timestamptz(3)
  riskReviewRequired Boolean        @default(false)
  foodRule           FoodScreenRule @default(EITHER)
  gofoodRating       Decimal?       @db.Decimal(2, 1)
  gofoodReviews      Int?
  gofoodUrl          String?        @db.VarChar(300)
  gofoodCheckedAt    DateTime?      @db.Timestamptz(3)
  grabfoodRating     Decimal?       @db.Decimal(2, 1)
  grabfoodReviews    Int?
  grabfoodUrl        String?        @db.VarChar(300)
  grabfoodCheckedAt  DateTime?      @db.Timestamptz(3)
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  @@index([riskReviewRequired, updatedAt])
}

model MappingOpportunity {
  id                 String               @id @default(cuid())
  prospectId         String
  prospect           Prospect             @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  productCode        String               @db.VarChar(80)
  needSummary        String               @db.VarChar(300)
  discoveredAt       DateTime?            @db.Timestamptz(3)
  needConfirmedAt    DateTime?            @db.Timestamptz(3)
  benefitExplainedAt DateTime?            @db.Timestamptz(3)
  response           MappingOfferResponse @default(NOT_ASKED)
  followUpConsent    Boolean?
  nextAction         String?              @db.VarChar(300)
  dueAt              DateTime?            @db.Timestamptz(3)
  evidenceNote       String?              @db.VarChar(500)
  assignedToId       String
  assignedTo         User                 @relation("MappingOpportunityAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  followUpId         String?              @unique
  followUp           FollowUp?            @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([prospectId, productCode])
  @@index([assignedToId, response, dueAt])
  @@index([prospectId, updatedAt])
}

model HandoverBatch {
  id            String          @id @default(cuid())
  batchNumber   String          @unique @db.VarChar(30)
  type          BatchType       @default(SINGLE)
  title         String          @db.VarChar(150)
  status        HandoverStatus  @default(DRAFT)
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  senderId      String
  sender        User            @relation("HandoverSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiverId    String?
  receiver      User?           @relation("HandoverReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  submittedAt   DateTime?       @db.Timestamptz(3)
  acceptedAt    DateTime?       @db.Timestamptz(3)
  readyAt       DateTime?       @db.Timestamptz(3)
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  items         HandoverItem[]
  exceptions    ExceptionCase[]
  notifications Notification[]

  @@index([branchId, status, updatedAt])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model HandoverItem {
  id         String        @id @default(cuid())
  batchId    String
  batch      HandoverBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  prospectId String        @unique
  prospect   Prospect      @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  note       String?       @db.VarChar(500)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([batchId, prospectId])
}

model ExceptionCase {
  id           String            @id @default(cuid())
  batchId      String
  batch        HandoverBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  prospectId   String?
  prospect     Prospect?         @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  category     ExceptionCategory
  title        String            @db.VarChar(150)
  detail       String            @db.VarChar(700)
  status       ExceptionStatus   @default(OPEN)
  assignedToId String?
  assignedTo   User?             @relation("ExceptionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  resolvedAt   DateTime?         @db.Timestamptz(3)
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@index([batchId, status])
  @@index([prospectId])
  @@index([assignedToId, status])
}

model UsageVerification {
  id                String      @id @default(cuid())
  prospectId        String
  prospect          Prospect    @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  status            UsageStatus @default(VERIFIED)
  usedAt            DateTime    @db.Timestamptz(3)
  evidenceReference String      @unique @db.VarChar(150)
  note              String?     @db.VarChar(500)
  recordedById      String
  recordedBy        User        @relation("UsageRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  @@index([prospectId, status, usedAt])
  @@index([recordedById, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String?  @db.VarChar(120)
  actorRole  Role?
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(100)
  action     String   @db.VarChar(80)
  before     Json?
  after      Json?
  requestId  String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([branchId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model AppConfig {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(300)
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model Visit {
  id              String       @id @default(cuid())
  prospectId      String
  prospect        Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  visitedAt       DateTime     @db.Timestamptz(3)
  outcome         VisitOutcome
  notes           String       @db.VarChar(700)
  nextAction      String?      @db.VarChar(300)
  nextActionDueAt DateTime?    @db.Timestamptz(3)
  createdById     String
  createdBy       User         @relation("VisitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([prospectId, visitedAt])
  @@index([createdById, visitedAt])
}

model Notification {
  id            BigInt           @id @default(autoincrement())
  recipientId   String
  recipient     User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type          NotificationType
  title         String           @db.VarChar(160)
  message       String           @db.VarChar(500)
  link          String           @db.VarChar(300)
  dedupKey      String           @unique @db.VarChar(180)
  isTest        Boolean          @default(false)
  testNamespace String?          @db.VarChar(80)
  followUpId    String?
  followUp      FollowUp?        @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  handoverId    String?
  handover      HandoverBatch?   @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  serviceCaseId String?
  serviceCase   ServiceCase?     @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  readAt        DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  deliveries    EmailDelivery[]

  @@index([recipientId, isTest, id])
  @@index([recipientId, readAt, createdAt])
  @@index([branchId, createdAt])
  @@index([serviceCaseId, id])
}

model OutboxJob {
  id              String         @id @default(cuid())
  type            OutboxJobType
  status          OutboxStatus   @default(PENDING)
  dedupKey        String         @unique @db.VarChar(180)
  isTest          Boolean        @default(false)
  testNamespace   String?        @db.VarChar(80)
  recipientId     String
  recipient       User           @relation("OutboxRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  followUpId      String?
  followUp        FollowUp?      @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  serviceCaseId   String?
  serviceCase     ServiceCase?   @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  scheduleVersion Int?
  runAt           DateTime       @db.Timestamptz(3)
  attempts        Int            @default(0)
  maxAttempts     Int            @default(3)
  lockedBy        String?        @db.VarChar(100)
  lockedAt        DateTime?      @db.Timestamptz(3)
  leaseExpiresAt  DateTime?      @db.Timestamptz(3)
  payload         Json?
  lastError       String?        @db.VarChar(1000)
  completedAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  emailDelivery   EmailDelivery?

  @@index([status, runAt])
  @@index([leaseExpiresAt, status])
  @@index([recipientId, status, runAt])
  @@index([followUpId, scheduleVersion])
  @@index([serviceCaseId, scheduleVersion])
}

model EmailDelivery {
  id             String              @id @default(cuid())
  outboxJobId    String              @unique
  outboxJob      OutboxJob           @relation(fields: [outboxJobId], references: [id], onDelete: Cascade)
  notificationId BigInt?
  notification   Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  recipientId    String
  recipient      User                @relation("EmailRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  status         EmailDeliveryStatus @default(QUEUED)
  messageId      String?             @db.VarChar(300)
  preview        String?             @db.Text
  error          String?             @db.VarChar(1000)
  acceptedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([recipientId, createdAt])
  @@index([status, createdAt])
  @@index([notificationId])
}

model ServiceCase {
  id                  String                   @id @default(cuid())
  code                String                   @unique @db.VarChar(36)
  branchId            String
  branch              Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  prospectId          String
  prospect            Prospect                 @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  origin              CaseOrigin
  status              ServiceCaseStatus        @default(CREATED)
  title               String                   @db.VarChar(160)
  description         String                   @db.VarChar(700)
  picId               String
  pic                 User                     @relation("ServiceCasePic", fields: [picId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           User                     @relation("ServiceCaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedById        String?
  acceptedBy          User?                    @relation("ServiceCaseAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)
  nextAction          String                   @db.VarChar(300)
  dueAt               DateTime                 @db.Timestamptz(3)
  appointmentStatus   AppointmentStatus        @default(NEEDS_SCHEDULING)
  appointmentAt       DateTime?                @db.Timestamptz(3)
  acquisitionCategory String?                  @db.VarChar(40)
  acquisitionProduct  String?                  @db.VarChar(80)
  acquisitionStatus   AcquisitionStatus        @default(PROSPECT)
  targetValue         Decimal?                 @db.Decimal(18, 2)
  realizationValue    Decimal?                 @db.Decimal(18, 2)
  metricUnit          AcquisitionMetricUnit?
  customerCif         String?                  @db.VarChar(40)
  customerAccount     String?                  @db.VarChar(40)
  customerPhone       String?                  @db.VarChar(30)
  acceptedAt          DateTime?                @db.Timestamptz(3)
  handledAt           DateTime?                @db.Timestamptz(3)
  verifiedAt          DateTime?                @db.Timestamptz(3)
  closedAt            DateTime?                @db.Timestamptz(3)
  reopenedAt          DateTime?                @db.Timestamptz(3)
  deletedAt           DateTime?                @db.Timestamptz(3)
  waitReason          String?                  @db.VarChar(500)
  escalationReason    String?                  @db.VarChar(500)
  sourceSystem        String?                  @db.VarChar(40)
  sourceReference     String?                  @db.VarChar(100)
  isTest              Boolean                  @default(false)
  testNamespace       String?                  @db.VarChar(80)
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  notifications       Notification[]
  outboxJobs          OutboxJob[]
  participants        ServiceCaseParticipant[]

  @@unique([sourceSystem, sourceReference])
  @@index([branchId, isTest, deletedAt, status, dueAt])
  @@index([picId, isTest, status, dueAt])
  @@index([prospectId, createdAt])
  @@index([appointmentStatus, appointmentAt])
  @@index([branchId, acquisitionCategory, acquisitionStatus])
}

model ServiceCaseParticipant {
  serviceCaseId String
  serviceCase   ServiceCase @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@id([serviceCaseId, userId])
  @@index([userId, createdAt])
}

model LocationPhoto {
  id          String   @id @default(cuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  storageKey  String   @unique @db.VarChar(180)
  mimeType    String   @db.VarChar(60)
  byteSize    Int
  width       Int
  height      Int
  checksum    String   @db.VarChar(64)
  createdById String
  createdBy   User     @relation("LocationPhotoCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([prospectId, createdAt])
}

model WorkerHeartbeat {
  id        String   @id @db.VarChar(100)
  processId Int
  hostname  String   @db.VarChar(160)
  lastSeen  DateTime @db.Timestamptz(3)
  startedAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
